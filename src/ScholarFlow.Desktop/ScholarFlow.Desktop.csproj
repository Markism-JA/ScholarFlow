<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ScholarFlow</AssemblyName>
    <Version>1.2.1</Version>
    <ApplicationIcon>..\..\assets\scholarflow.ico</ApplicationIcon>
    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="..\..\assets\scholarflow.ico"
      LogicalName="ScholarFlow.Assets.scholarflow.ico"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScholarFlow.Core\ScholarFlow.Core.csproj" />
    <ProjectReference Include="..\ScholarFlow.Elms\ScholarFlow.Elms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.10.4" />
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.4.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.65.0" />
    <PackageReference Include="PDFtoImage" Version="4.1.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
